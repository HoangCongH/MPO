@model MPO_Web_Prj.Models.Report.DowntimeReportViewModel

@{
    ViewData["Title"] = "Downtime Report";
    Layout = "_DashboardLayout";
    var lineRows = Model.Rows
        .OrderBy(row => int.TryParse(row.LineName, out var lineNumber) ? lineNumber : int.MaxValue)
        .ThenBy(row => row.LineName, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var downtimeTableMinWidth = lineRows.Count <= 4
        ? 720
        : 330 + (lineRows.Count * 150);
}

<section class="pp-report pp-report--table">
    <h1 class="pp-report__title"><i data-lucide="alert-circle" style="margin-right: 8px;"></i>DOWNTIME REPORT</h1>

    <form class="pp-report__filter"
          asp-controller="DowntimeReport"
          asp-action="Index"
          method="post">
        <div class="pp-report__field">
            <label asp-for="Filter.LineName">Line Name</label>
            <select asp-for="Filter.LineName"
                    asp-items="@(new SelectList(Model.LineOptions, "Value", "Text", Model.Filter.LineName))">
            </select>
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.StartDate">Start</label>
            <input asp-for="Filter.StartDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            <input asp-for="Filter.StartTime" type="time" step="1" asp-format="{0:HH:mm:ss}" />
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.EndDate">End</label>
            <input asp-for="Filter.EndDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            <input asp-for="Filter.EndTime" type="time" step="1" asp-format="{0:HH:mm:ss}" />
        </div>

        <button class="pp-report__button" type="submit"><i data-lucide="filter" style="width: 16px; margin-right: 6px;"></i>Apply</button>

        <button class="pp-report__button"
                type="submit"
                asp-action="ExportExcel"
                style="background: linear-gradient(135deg, #10B981 0%, #059669 100%) !important;">
            <i data-lucide="download" style="width: 16px; margin-right: 6px;"></i>Export Excel
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="report-error">
            @Model.ErrorMessage
        </div>
    }

    <div class="pp-report__table-wrap downtime-matrix-wrap @(lineRows.Count <= 4 ? "downtime-matrix-wrap--fit" : string.Empty)" data-report-batch-url="@Url.Action("Batch", "DowntimeReport")" data-next-offset="@Model.Rows.Count" data-has-more="@(Model.Pagination.TotalRecords > Model.Rows.Count)" data-report-orientation="transposed" data-report-fixed-columns="2" data-report-columns="lineName,chipPickupErrorCount,chipPickupErrorTime,chipRecogErrorCount,chipRecogErrorTime,singleErrorStopCount,singleErrorStopTime,troubleStopCount,troubleStopTime,partExhaustStopCount,partExhaustStopTime">
        <table class="pp-report__table pp-report__table--downtime" data-column-layout-version="downtime-transposed-v2" style="min-width: @(downtimeTableMinWidth)px;">
            <colgroup data-report-transposed-cols>
                <col style="width: 120px;" />
                <col style="width: 210px;" />
                @foreach (var _ in lineRows)
                {
                    <col />
                }
            </colgroup>
            <thead>
                <tr data-report-transposed-header>
                    <th scope="col">Category</th>
                    <th scope="col">Error</th>
                    @foreach (var row in lineRows)
                    {
                        <th scope="col">@(row.LineName.StartsWith("Line", StringComparison.OrdinalIgnoreCase) ? row.LineName : $"Line {row.LineName}")</th>
                    }
                </tr>
            </thead>
            <tbody data-report-batch-rows>
                @if (lineRows.Count > 0)
                {
                    <tr data-report-metric="chipPickupErrorCount">
                        <th class="downtime-matrix__category" scope="rowgroup" rowspan="5">COUNT</th>
                        <th class="downtime-matrix__metric" scope="row">Chip pickup error</th>
                        @foreach (var row in lineRows) { <td>@row.ChipPickupErrorCount</td> }
                    </tr>
                    <tr data-report-metric="chipRecogErrorCount">
                        <th class="downtime-matrix__metric" scope="row">Chip recog error</th>
                        @foreach (var row in lineRows) { <td>@row.ChipRecogErrorCount</td> }
                    </tr>
                    <tr data-report-metric="singleErrorStopCount">
                        <th class="downtime-matrix__metric" scope="row">Single error stop</th>
                        @foreach (var row in lineRows) { <td>@row.SingleErrorStopCount</td> }
                    </tr>
                    <tr data-report-metric="troubleStopCount">
                        <th class="downtime-matrix__metric" scope="row">Trouble stop</th>
                        @foreach (var row in lineRows) { <td>@row.TroubleStopCount</td> }
                    </tr>
                    <tr data-report-metric="partExhaustStopCount">
                        <th class="downtime-matrix__metric" scope="row">Part exhaust stop</th>
                        @foreach (var row in lineRows) { <td>@row.PartExhaustStopCount</td> }
                    </tr>
                    <tr data-report-metric="chipPickupErrorTime">
                        <th class="downtime-matrix__category" scope="rowgroup" rowspan="5">TIME</th>
                        <th class="downtime-matrix__metric" scope="row">Chip pickup error</th>
                        @foreach (var row in lineRows) { <td>@row.ChipPickupErrorTime.ToString("N2")</td> }
                    </tr>
                    <tr data-report-metric="chipRecogErrorTime">
                        <th class="downtime-matrix__metric" scope="row">Chip recog error</th>
                        @foreach (var row in lineRows) { <td>@row.ChipRecogErrorTime.ToString("N2")</td> }
                    </tr>
                    <tr data-report-metric="singleErrorStopTime">
                        <th class="downtime-matrix__metric" scope="row">Single error stop</th>
                        @foreach (var row in lineRows) { <td>@row.SingleErrorStopTime.ToString("N2")</td> }
                    </tr>
                    <tr data-report-metric="troubleStopTime">
                        <th class="downtime-matrix__metric" scope="row">Trouble stop</th>
                        @foreach (var row in lineRows) { <td>@row.TroubleStopTime.ToString("N2")</td> }
                    </tr>
                    <tr data-report-metric="partExhaustStopTime">
                        <th class="downtime-matrix__metric" scope="row">Part exhaust stop</th>
                        @foreach (var row in lineRows) { <td>@row.PartExhaustStopTime.ToString("N2")</td> }
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="pp-report__empty" colspan="2">
                            No downtime data found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</section>
