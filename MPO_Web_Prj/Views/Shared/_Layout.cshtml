<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>MES Dashboard</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Toolbar -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container-fluid">

            <a class="navbar-brand">
                MES Dashboard
            </a>

            <div class="navbar-nav" >

                <a class="nav-link"
                   asp-controller="Dashboard"
                   asp-action="DataView">

                    Data View

                </a>

                <a class="nav-link"
                   asp-controller="Dashboard"
                   asp-action="RunTime">

                    Run Time

                </a>

                <a class="nav-link"
                   asp-controller="Dashboard"
                   asp-action="StopTime">

                    Stop Time

                </a>
                <a class="nav-link"
                   asp-controller="ProductionReport"
                   asp-action="Index">

                    Production Report

                </a>
            </div>

        </div>

    </nav>

    <div class="container-fluid">

        <div class="row">

            <!-- ✅ SIDEBAR -->
            <div class="col-md-2 border-end"
                 style="height: calc(100vh - 56px); overflow:auto;">

                <h5 class="mt-2">DEMO</h5>

                <ul class="list-unstyled">
                    <li>
                        F1
                        <ul>
                            <li>Line1</li>
                            <li>
                                Line2
                                <ul>
                                    <li>NPM-1</li>
                                    <li>NPM-2</li>
                                    <li>NPM-3</li>
                                    <li>NPM-4</li>
                                    <li style="background-color: lightgreen;">NPM-5</li>
                                    <li>NPM-6</li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                </ul>

            </div>

            <!-- ✅ CONTENT -->
            <div class="col-md-10 mt-3">
                @RenderBody()
            </div>

        </div>

    </div>

</body>
</html>
