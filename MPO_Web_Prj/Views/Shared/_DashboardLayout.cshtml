<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MES Dashboard</title>
    <script>
        (() => {
            try {
                if (localStorage.getItem('mpo-sidebar-collapsed') === 'true') {
                    document.documentElement.classList.add('is-sidebar-collapsed');
                }
            } catch {
                // Keep the default expanded layout if storage is unavailable.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="dashboard-shell">
    <button class="app-sidebar-toggle"
            type="button"
            aria-label="Toggle sidebar"
            aria-controls="appSidebar"
            aria-expanded="true">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <aside class="app-sidebar" id="appSidebar">
        <a class="app-sidebar__brand" asp-controller="Dashboard" asp-action="Index">MES Dashboard</a>

        <nav class="app-sidebar__nav">
            <a class="app-sidebar__home" asp-controller="Dashboard" asp-action="Index" data-nav-controller="Dashboard" data-nav-action="Index">Home</a>

            <span class="app-sidebar__section">Charts</span>
            <a asp-controller="OverallDashboard" asp-action="Index" data-nav-controller="OverallDashboard" data-nav-action="Index">Overall Dashboard</a>
            <a asp-controller="BoardCount" asp-action="Index" data-nav-controller="BoardCount" data-nav-action="Index">Board count</a>

            <span class="app-sidebar__section">Reports</span>
            <a asp-controller="ProductionReport" asp-action="Index" data-nav-controller="ProductionReport" data-nav-action="Index">Production Report</a>
            <a asp-controller="PPReport_ByPart" asp-action="Index" data-nav-controller="PPReport_ByPart" data-nav-action="Index">Pick-Placement by Part</a>
            <a asp-controller="PPReport_ByFeeder" asp-action="Index" data-nav-controller="PPReport_ByFeeder" data-nav-action="Index">Pick-Placement by Feeder</a>
            <a asp-controller="PPReport_ByNozzle" asp-action="Index" data-nav-controller="PPReport_ByNozzle" data-nav-action="Index">Pick-Placement by Nozzle</a>
            <a asp-controller="CycleTimeReport" asp-action="Index" data-nav-controller="CycleTimeReport" data-nav-action="Index">Cycle Time Report</a>
            <a asp-controller="DowntimeReport" asp-action="Index" data-nav-controller="DowntimeReport" data-nav-action="Index">Downtime Report</a>
            <a asp-controller="TotalPickupPlacementReport" asp-action="Index" data-nav-controller="TotalPickupPlacementReport" data-nav-action="Index">Total Pickup Placement Per Line</a>
        </nav>
    </aside>

    <main class="app-main">
        @RenderBody()
    </main>
    <script>
        (() => {
            const storageKey = 'mpo-sidebar-collapsed';
            const toggle = document.querySelector('.app-sidebar-toggle');

            if (!toggle) {
                return;
            }

            const setCollapsed = isCollapsed => {
                document.documentElement.classList.toggle('is-sidebar-collapsed', isCollapsed);
                document.body.classList.toggle('is-sidebar-collapsed', isCollapsed);
                toggle.setAttribute('aria-expanded', (!isCollapsed).toString());
                localStorage.setItem(storageKey, isCollapsed ? 'true' : 'false');
                window.setTimeout(() => window.dispatchEvent(new Event('resize')), 260);
            };

            setCollapsed(localStorage.getItem(storageKey) === 'true');

            toggle.addEventListener('click', () => {
                setCollapsed(!document.body.classList.contains('is-sidebar-collapsed'));
            });
        })();

        (() => {
            const pathParts = window.location.pathname.split('/').filter(Boolean);
            const currentController = (pathParts[0] || 'Dashboard').toLowerCase();
            const currentAction = (pathParts[1] || 'Index').toLowerCase();

            document.querySelectorAll('.app-sidebar__nav a[data-nav-controller]').forEach(link => {
                const linkController = (link.dataset.navController || '').toLowerCase();
                const linkAction = (link.dataset.navAction || 'Index').toLowerCase();
                const isDashboardRoot = currentController === 'dashboard'
                    && currentAction === 'index'
                    && linkController === 'dashboard'
                    && linkAction === 'index';
                const isCurrent = linkController === currentController
                    && (linkAction === currentAction || (currentAction === 'index' && linkAction === 'index'));

                if (isCurrent || isDashboardRoot) {
                    link.classList.add('is-active');
                    link.setAttribute('aria-current', 'page');
                }

                link.addEventListener('click', event => {
                    if (window.mpoIsNavigating === true) {
                        event.preventDefault();
                        return;
                    }

                    window.mpoIsNavigating = true;
                    window.setTimeout(() => {
                        window.mpoIsNavigating = false;
                    }, 1500);
                });
            });

            document.querySelectorAll('form.pp-report__filter').forEach(form => {
                const storageKey = `mpo-filter:${window.location.pathname.toLowerCase()}`;
                const hasQuery = window.location.search.length > 1;
                const requiredDateTimeFields = ['StartDate', 'StartTime', 'EndDate', 'EndTime'];

                requiredDateTimeFields.forEach(fieldName => {
                    const field = form.elements.namedItem(fieldName)
                        || form.elements.namedItem(`Filter.${fieldName}`);
                    if (field) {
                        field.required = true;
                    }
                });

                if (!hasQuery && form.dataset.skipFilterRestore !== 'true') {
                    const storedQuery = sessionStorage.getItem(storageKey);
                    if (storedQuery) {
                        const values = new URLSearchParams(storedQuery);
                        for (const [key, value] of values.entries()) {
                            const field = form.elements.namedItem(key);
                            if (!field) {
                                continue;
                            }

                            if (typeof RadioNodeList !== 'undefined' && field instanceof RadioNodeList) {
                                field.value = value;
                                continue;
                            }

                            if (field.tagName === 'SELECT'
                                && value
                                && !Array.from(field.options).some(option => option.value === value)) {
                                field.add(new Option(value, value, true, true));
                            }

                            field.value = value;
                            field.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    }
                }

                form.addEventListener('submit', event => {
                    if (form.dataset.isSubmitting === 'true') {
                        event.preventDefault();
                        return;
                    }

                    form.dataset.isSubmitting = 'true';

                    const data = new FormData(form);
                    const query = new URLSearchParams();

                    for (const [key, value] of data.entries()) {
                        if (value !== null && value !== '') {
                            query.append(key, value.toString());
                        }
                    }

                    sessionStorage.setItem(storageKey, query.toString());

                    form.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(button => {
                        button.disabled = true;
                        button.classList.add('is-loading');
                    });
                });
            });
        })();

        (() => {
            const storagePrefix = `mpo-table-columns:${window.location.pathname.toLowerCase()}`;

            document.querySelectorAll('table').forEach((table, tableIndex) => {
                if (!table.tHead || table.dataset.columnResizeInitialized === 'true') {
                    return;
                }

                table.dataset.columnResizeInitialized = 'true';
                const headers = Array.from(table.tHead.rows[0].cells);
                const key = `${storagePrefix}:${table.className || 'table'}:${tableIndex}`;
                let colGroup = table.querySelector(':scope > colgroup');

                if (!colGroup) {
                    colGroup = document.createElement('colgroup');
                    table.insertBefore(colGroup, table.tHead);
                }

                while (colGroup.children.length < headers.length) {
                    colGroup.appendChild(document.createElement('col'));
                }

                const savedWidths = JSON.parse(localStorage.getItem(key) || '[]');
                headers.forEach((header, columnIndex) => {
                    const col = colGroup.children[columnIndex];
                    const initialWidth = savedWidths[columnIndex] || Math.round(header.getBoundingClientRect().width);
                    if (initialWidth > 0) {
                        col.style.width = `${initialWidth}px`;
                    }

                    const resizer = document.createElement('span');
                    resizer.className = 'table-column-resizer';
                    resizer.setAttribute('aria-label', `Resize ${header.textContent.trim()} column`);
                    header.appendChild(resizer);

                    resizer.addEventListener('pointerdown', event => {
                        event.preventDefault();
                        resizer.setPointerCapture(event.pointerId);
                        resizer.classList.add('is-resizing');
                        const startX = event.clientX;
                        const startWidth = header.getBoundingClientRect().width;

                        const resize = moveEvent => {
                            const width = Math.max(60, Math.round(startWidth + moveEvent.clientX - startX));
                            col.style.width = `${width}px`;
                        };

                        const finish = () => {
                            resizer.classList.remove('is-resizing');
                            const widths = Array.from(colGroup.children).map(item => Math.round(item.getBoundingClientRect().width));
                            localStorage.setItem(key, JSON.stringify(widths));
                            resizer.removeEventListener('pointermove', resize);
                            resizer.removeEventListener('pointerup', finish);
                            resizer.removeEventListener('pointercancel', finish);
                        };

                        resizer.addEventListener('pointermove', resize);
                        resizer.addEventListener('pointerup', finish);
                        resizer.addEventListener('pointercancel', finish);
                    });
                });
            });
        })();

        (() => {
            document.addEventListener('click', event => {
                const button = event.target.closest('[data-report-page]');
                if (!button) {
                    return;
                }

                const form = document.querySelector('form.pp-report__filter');
                if (!form) {
                    return;
                }

                let pageInput = form.querySelector('input[name="Filter.Page"]');
                if (!pageInput) {
                    pageInput = document.createElement('input');
                    pageInput.type = 'hidden';
                    pageInput.name = 'Filter.Page';
                    form.appendChild(pageInput);
                }
                
                pageInput.value = button.dataset.reportPage;

                const submitBtn = form.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.click();
                } else {
                    form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                    if (!form.dataset.isSubmitting) {
                        form.submit();
                    }
                }
            });

            document.querySelectorAll('form.pp-report__filter').forEach(form => {
                form.addEventListener('submit', () => {
                    const pageInput = form.querySelector('input[name="Filter.Page"]');
                    if (pageInput && !form.dataset.isSubmitting && !event?.target?.closest?.('[data-report-page]')) {
                        // Reset page to 1 on regular filter apply
                        pageInput.value = '1';
                    }
                });
            });
        })();
    </script>
</body>
</html>
