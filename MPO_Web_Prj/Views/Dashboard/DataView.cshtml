            <!-- MAIN CONTENT -->
            <div class="col-md-10">

                <!-- HEADER -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h3>Data Views</h3>
                    </div>

                    <div class="card-body">

                        <!-- FILTER -->
                        <div class="row mb-3">

                            <div class="col-auto">
                                <input type="datetime-local" class="form-control" />
                            </div>

                            <div class="col-auto">
                                <input type="datetime-local" class="form-control" />
                            </div>

                            <div class="col-auto">
                                <select class="form-select">
                                    <option>Run Time by machine per hour</option>
                                    <option>Stop Time by machine per hour</option>
                                </select>
                            </div>

                            <div class="col-auto">
                                <button class="btn btn-primary">GO</button>
                            </div>

                            <div class="col-auto">
                                <button class="btn btn-success">Export Excel</button>
                            </div>
                            <div class="col-auto">

                                <form asp-action="AddMachine"
                                      asp-controller="DataView"
                                      method="post">

                                    <button class="btn btn-warning">

                                        Add

                                    </button>

                                </form>

                            </div>
                        </div>

                        <!-- CHART -->
                        <div class="mb-4">
                            <canvas id="runtimeChart" height="100"></canvas>
                        </div>

                        <!-- TABLE -->
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">

                                <thead class="table-dark">
                                    <tr>
                                        <th>Machine</th>
                                        <th>Time</th>
                                        <th>Run %</th>
                                        <th>Wait %</th>
                                        <th>Stop %</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr>
                                        <td>LINE1_NPM-1</td>
                                        <td>2025-06-10 08:00</td>
                                        <td>38.9%</td>
                                        <td>0%</td>
                                        <td>51.8%</td>
                                    </tr>

                                    <tr>
                                        <td>LINE1_NPM-2</td>
                                        <td>2025-06-10 08:00</td>
                                        <td>41.2%</td>
                                        <td>0%</td>
                                        <td>47.5%</td>
                                    </tr>
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        const ctx =
        document.getElementById('runtimeChart');

        new Chart(ctx,
        {
            type: 'line',

            data:
