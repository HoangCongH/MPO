@model MPO_Web_Prj.Models.Report.OverallDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Overall Dashboard";
    Layout = "_DashboardLayout";

    var boardPayload = Model.BoardProduced.Charts.Select(chart => new
    {
        lineName = chart.LineName,
        labels = chart.Labels,
        series = chart.Series.Select(series => new
        {
            laneName = series.LaneName,
            values = series.Values
        })
    });

    var errorStopPayload = new
    {
        labels = Model.ErrorStopTime.Select(slice => slice.Label),
        values = Model.ErrorStopTime.Select(slice => slice.Value)
    };

    var errorStopColors = new[] { "#6366F1", "#38BDF8", "#22C55E", "#F59E0B", "#EF4444", "#8B5CF6" };
    var errorStopTotal = Model.ErrorStopTime.Sum(slice => slice.Value);
    var dashboardPayload = new
    {
        charts = boardPayload,
        errorStop = errorStopPayload,
        feeders = Model.TopWorstFeeders,
        nozzles = Model.TopWorstNozzles
    };
}

<section class="pp-report overall-dashboard">
    <div class="overall-dashboard__page-heading">
        <h1 class="pp-report__title">Overall Dashboard (per line)</h1>
    </div>

    <form class="pp-report__filter board-count-filter"
          asp-controller="OverallDashboard"
          asp-action="Index"
          data-skip-filter-restore="true"
          method="post">
        <input type="hidden" name="AutoRefresh" value="@Model.BoardProduced.Filter.AutoRefresh" />
        <div class="pp-report__field overall-dashboard-line-field">
            <label asp-for="BoardProduced.Filter.Line1">Line</label>
            <select asp-for="BoardProduced.Filter.Line1" name="Line1" asp-items="@(new SelectList(Model.BoardProduced.LineOptions, "Value", "Text", Model.BoardProduced.Filter.Line1))"></select>
        </div>

        <div class="pp-report__field">
            <label asp-for="BoardProduced.Filter.Shift">Time</label>
            <select asp-for="BoardProduced.Filter.Shift" name="Shift" id="overallDashboardTime" required>
                <option value="1">Shift 1: 6:00 - 18:00</option>
                <option value="2">Shift 2: 18:00 - 6:00 next day</option>
                <option value="3">All Day</option>
                <option value="4">Last Hour</option>
            </select>
        </div>

        <div class="pp-report__field overall-dashboard-date-field">
            <label asp-for="BoardProduced.Filter.StartDate">Start</label>
            <input asp-for="BoardProduced.Filter.StartDate" name="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" />
        </div>

        <div class="pp-report__field overall-dashboard-date-field">
            <label asp-for="BoardProduced.Filter.EndDate">End</label>
            <input asp-for="BoardProduced.Filter.EndDate" name="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" />
        </div>

        <button class="pp-report__button" type="submit"><i data-lucide="filter" style="width: 16px; margin-right: 6px;"></i>Apply</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="report-error">@Model.ErrorMessage</div>
    }

    <div class="overall-dashboard__grid">
        <section class="overall-dashboard__panel overall-dashboard__panel--board">
            <h2>Board produced</h2>
            <div class="overall-dashboard__board-grid">
                @for (var i = 0; i < Model.BoardProduced.Charts.Count; i++)
                {
                    <div class="overall-dashboard__chart-box">
                        <h3>@Model.BoardProduced.Charts[i].LineName</h3>
                        <div class="overall-dashboard__canvas">
                            <canvas id="overallBoardProducedChart@(i)"></canvas>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="overall-dashboard__panel overall-dashboard__panel--feeder">
            <h2>Top worst feeder</h2>
            <div class="overall-dashboard__table-wrap">
                <table class="overall-dashboard__table overall-dashboard__table--feeder">
                    <colgroup>
                        <col style="width: 18%;" />
                        <col style="width: 8%;" />
                        <col style="width: 12%;" />
                        <col style="width: 7%;" />
                        <col style="width: 21%;" />
                        <col style="width: 12%;" />
                        <col style="width: 13%;" />
                        <col style="width: 9%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Feeder id</th>
                            <th>Table</th>
                            <th>Feeder slot</th>
                            <th>Side</th>
                            <th>Part name</th>
                            <th>Total pickup</th>
                            <th>Total placement</th>
                            <th>PPM</th>
                        </tr>
                    </thead>
                    <tbody id="overallWorstFeederRows">
                        @foreach (var row in Model.TopWorstFeeders)
                        {
                            <tr>
                                <td>@row.FeederId</td>
                                <td>@row.FeederTable</td>
                                <td>@row.FeederSlot</td>
                                <td>@row.Side</td>
                                <td>@row.PartName</td>
                                <td>@row.TotalPickup</td>
                                <td>@row.TotalPlacement</td>
                                <td>@row.Ppm.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.TopWorstFeeders.Count == 0)
                        {
                            <tr>
                                <td class="pp-report__empty" colspan="8">No feeder data found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="overall-dashboard__panel overall-dashboard__panel--error">
            <h2>Error stop time</h2>
            <div class="overall-dashboard__pie">
                <div class="overall-dashboard__pie-chart">
                    <canvas id="overallErrorStopTimeChart"></canvas>
                </div>
                <ul class="overall-dashboard__pie-legend" id="overallErrorStopLegend" aria-label="Error stop time legend">
                    @for (var i = 0; i < Model.ErrorStopTime.Count; i++)
                    {
                        var slice = Model.ErrorStopTime[i];
                        var color = errorStopColors[i % errorStopColors.Length];
                        var percent = errorStopTotal > 0
                            ? slice.Value / errorStopTotal * 100
                            : 0;
                        <li>
                            <span class="overall-dashboard__pie-swatch" style="background-color: @color"></span>
                            <span class="overall-dashboard__pie-label">@slice.Label</span>
                            <span class="overall-dashboard__pie-value">@percent.ToString("N2")%</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section class="overall-dashboard__panel overall-dashboard__panel--nozzle">
            <h2>Top worst nozzle</h2>
            <div class="overall-dashboard__table-wrap">
                <table class="overall-dashboard__table">
                    <thead>
                        <tr>
                            <th>Nozzle slot</th>
                            <th>Head</th>
                            <th>Part name</th>
                            <th>Total pickup</th>
                            <th>Total placement</th>
                            <th>PPM</th>
                        </tr>
                    </thead>
                    <tbody id="overallWorstNozzleRows">
                        @foreach (var row in Model.TopWorstNozzles)
                        {
                            <tr>
                                <td>@row.NozzleSlot</td>
                                <td>@row.Head</td>
                                <td>@row.PartName</td>
                                <td>@row.TotalPickup</td>
                                <td>@row.TotalPlacement</td>
                                <td>@row.Ppm.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.TopWorstNozzles.Count == 0)
                        {
                            <tr>
                                <td class="pp-report__empty" colspan="6">No nozzle data found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>

<script>
    const initialOverallDashboardData = @Html.Raw(JsonSerializer.Serialize(dashboardPayload));
    const overallBoardCharts = initialOverallDashboardData.charts;
    const overallErrorStopChart = initialOverallDashboardData.errorStop;
    const overallDashboardColors = ['#6366F1', '#38BDF8', '#22C55E', '#F59E0B', '#EF4444', '#8B5CF6'];

    const createOverallIntervalChartData = chart => {
        const boundaryLabels = createOverallBoundaryLabels(chart.labels);

        return {
            boundaryLabels,
            datasets: chart.series.map((series, seriesIndex) => ({
                label: series.laneName,
                data: series.values.map((value, valueIndex) => ({
                    x: valueIndex + 0.5,
                    y: value
                })),
                backgroundColor: overallDashboardColors[seriesIndex % overallDashboardColors.length],
                borderWidth: 0,
                stack: 'board-produced'
            }))
        };
    };

    const createOverallBoundaryLabels = labels => {
        if (!labels.length) {
            return [];
        }

        return [...labels, getNextOverallBoundaryLabel(labels)];
    };

    const getNextOverallBoundaryLabel = labels => {
        const lastLabel = labels[labels.length - 1] || '';
        const hourMatch = lastLabel.match(/^(\d{2}):00$/);

        if (!hourMatch) {
            return '';
        }

        const nextHour = Number(hourMatch[1]) + 1;
        return nextHour === 24
            ? '24:00'
            : `${String(nextHour % 24).padStart(2, '0')}:00`;
    };

    const getOverallBoardBarThickness = (canvas, bucketCount) => {
        const chartWidth = canvas.parentElement?.clientWidth || canvas.clientWidth || 360;
        const availableWidthPerBucket = chartWidth / Math.max(bucketCount, 1);
        return Math.max(10, Math.min(30, Math.floor(availableWidthPerBucket * 0.55)));
    };

    (() => {
        const timeSelect = document.getElementById('overallDashboardTime');
        const dateFields = document.querySelectorAll('.overall-dashboard-date-field input');

        if (!timeSelect) {
            return;
        }

        const syncDateFields = () => {
            const isLastHour = timeSelect.value === '4';
            dateFields.forEach(field => {
                field.disabled = isLastHour;
                field.required = !isLastHour;
            });
        };

        timeSelect.addEventListener('change', syncDateFields);
        syncDateFields();
    })();

    overallBoardCharts.forEach((chart, index) => {
        const canvas = document.getElementById(`overallBoardProducedChart${index}`);
        if (!canvas) {
            return;
        }

        const intervalChart = createOverallIntervalChartData(chart);
        const bucketCount = Math.max(intervalChart.boundaryLabels.length - 1, 1);
        const boardBarThickness = getOverallBoardBarThickness(canvas, bucketCount);

        new Chart(canvas, {
            type: 'bar',
            data: {
                datasets: intervalChart.datasets
            },
            options: {
                animation: true,
                maintainAspectRatio: false,
                normalized: true,
                responsive: true,
                layout: {
                    padding: {
                        left: 8,
                        right: 8,
                        bottom: 6
                    }
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 10, font: { size: 12 }, color: '#B6C2D9' }
                    },
                    tooltip: {
                        callbacks: {
                            title: context => {
                                const bucketIndex = Math.floor(context[0].parsed.x);
                                const start = intervalChart.boundaryLabels[bucketIndex] || '';
                                const end = intervalChart.boundaryLabels[bucketIndex + 1] || '';
                                return end ? `${start} - ${end}` : start;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: 'linear',
                        stacked: true,
                        min: 0,
                        max: bucketCount,
                        offset: false,
                        ticks: {
                            autoSkip: false,
                            includeBounds: true,
                            maxRotation: 60,
                            minRotation: 60,
                            stepSize: 1,
                            color: '#B6C2D9',
                            font: { size: 9 },
                            callback: value => Number.isInteger(value)
                                ? intervalChart.boundaryLabels[value] || ''
                                : ''
                        },
                        grid: { display: false, drawTicks: false },
                        border: { display: true, color: 'rgba(182,194,217,0.48)' }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        grid: { display: false, drawTicks: false },
                        border: { display: true, color: 'rgba(182,194,217,0.48)' },
                        ticks: { color: '#B6C2D9' }
                    }
                },
                datasets: {
                    bar: {
                        barThickness: boardBarThickness,
                        maxBarThickness: 30
                    }
                }
            }
        });
    });

    const errorStopCanvas = document.getElementById('overallErrorStopTimeChart');
    if (errorStopCanvas) {
        new Chart(errorStopCanvas, {
            type: 'pie',
            data: {
                labels: overallErrorStopChart.labels,
                datasets: [{
                    data: overallErrorStopChart.values,
                    backgroundColor: overallDashboardColors,
                    borderColor: '#1D2645',
                    borderWidth: 2
                }]
            },
            options: {
                animation: false,
                maintainAspectRatio: false,
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    }

    const overallBoardGrid = document.querySelector('.overall-dashboard__board-grid');
    const overallFeederRows = document.getElementById('overallWorstFeederRows');
    const overallNozzleRows = document.getElementById('overallWorstNozzleRows');
    const overallErrorStopLegend = document.getElementById('overallErrorStopLegend');
    const overallDashboardForm = document.querySelector('.overall-dashboard .board-count-filter');
    const overallAutoRefreshInput = overallDashboardForm?.querySelector('input[name="AutoRefresh"]');
    let overallRefreshInFlight = false;

    const createOverallBoardChart = (canvas, chart) => {
        const intervalChart = createOverallIntervalChartData(chart);
        const bucketCount = Math.max(intervalChart.boundaryLabels.length - 1, 1);

        return new Chart(canvas, {
            type: 'bar',
            data: { datasets: intervalChart.datasets },
            options: {
                animation: false,
                maintainAspectRatio: false,
                normalized: true,
                responsive: true,
                layout: { padding: { left: 8, right: 8, bottom: 6 } },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 12 }, color: '#B6C2D9' } },
                    tooltip: {
                        callbacks: {
                            title: context => {
                                const bucketIndex = Math.floor(context[0].parsed.x);
                                const start = intervalChart.boundaryLabels[bucketIndex] || '';
                                const end = intervalChart.boundaryLabels[bucketIndex + 1] || '';
                                return end ? `${start} - ${end}` : start;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: 'linear', stacked: true, min: 0, max: bucketCount, offset: false,
                        ticks: {
                            autoSkip: false, includeBounds: true, maxRotation: 60, minRotation: 60, stepSize: 1,
                            color: '#B6C2D9', font: { size: 9 },
                            callback: value => Number.isInteger(value) ? intervalChart.boundaryLabels[value] || '' : ''
                        },
                        grid: { display: false, drawTicks: false },
                        border: { display: true, color: 'rgba(182,194,217,0.48)' }
                    },
                    y: {
                        stacked: true, beginAtZero: true, ticks: { color: '#B6C2D9' },
                        grid: { display: false, drawTicks: false },
                        border: { display: true, color: 'rgba(182,194,217,0.48)' }
                    }
                },
                datasets: { bar: { barThickness: getOverallBoardBarThickness(canvas, bucketCount), maxBarThickness: 30 } }
            }
        });
    };

    const renderOverallBoardCharts = charts => {
        document.querySelectorAll('[id^="overallBoardProducedChart"]').forEach(canvas => Chart.getChart(canvas)?.destroy());
        overallBoardGrid.replaceChildren();
        charts.forEach((chart, index) => {
            const box = document.createElement('div');
            box.className = 'overall-dashboard__chart-box';
            const title = document.createElement('h3');
            title.textContent = chart.lineName;
            const canvasWrap = document.createElement('div');
            canvasWrap.className = 'overall-dashboard__canvas';
            const canvas = document.createElement('canvas');
            canvas.id = `overallBoardProducedChart${index}`;
            canvasWrap.appendChild(canvas);
            box.append(title, canvasWrap);
            overallBoardGrid.appendChild(box);
            createOverallBoardChart(canvas, chart);
        });
    };

    const renderOverallRows = (tbody, rows, columns, emptyMessage) => {
        tbody.replaceChildren();
        if (!rows.length) {
            const row = document.createElement('tr');
            const cell = document.createElement('td');
            cell.className = 'pp-report__empty';
            cell.colSpan = columns.length;
            cell.textContent = emptyMessage;
            row.appendChild(cell);
            tbody.appendChild(row);
            return;
        }
        rows.forEach(item => {
            const row = document.createElement('tr');
            columns.forEach(column => {
                const cell = document.createElement('td');
                const value = item[column];
                cell.textContent = column === 'ppm' ? Number(value || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : value ?? '';
                row.appendChild(cell);
            });
            tbody.appendChild(row);
        });
    };

    const renderErrorStop = errorStop => {
        const canvas = document.getElementById('overallErrorStopTimeChart');
        Chart.getChart(canvas)?.destroy();
        new Chart(canvas, {
            type: 'pie',
            data: { labels: errorStop.labels, datasets: [{ data: errorStop.values, backgroundColor: overallDashboardColors, borderColor: '#1D2645', borderWidth: 2 }] },
            options: { animation: false, maintainAspectRatio: false, responsive: true, plugins: { legend: { display: false } } }
        });
        overallErrorStopLegend.replaceChildren();
        const total = errorStop.values.reduce((sum, value) => sum + Number(value || 0), 0);
        errorStop.labels.forEach((label, index) => {
            const item = document.createElement('li');
            const swatch = document.createElement('span');
            swatch.className = 'overall-dashboard__pie-swatch';
            swatch.style.backgroundColor = overallDashboardColors[index % overallDashboardColors.length];
            const text = document.createElement('span');
            text.className = 'overall-dashboard__pie-label';
            text.textContent = label;
            const value = document.createElement('span');
            value.className = 'overall-dashboard__pie-value';
            value.textContent = `${(total ? Number(errorStop.values[index] || 0) / total * 100 : 0).toFixed(2)}%`;
            item.append(swatch, text, value);
            overallErrorStopLegend.appendChild(item);
        });
    };

    const refreshOverallDashboard = async () => {
        if (overallRefreshInFlight || !overallDashboardForm) return;
        overallRefreshInFlight = true;
        try {
            const body = new FormData(overallDashboardForm);
            const now = new Date();
            const localNow = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}T${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
            body.append('ClientNow', localNow);
            const response = await fetch('@Url.Action("Refresh", "OverallDashboard")', { method: 'POST', body, credentials: 'same-origin' });
            if (!response.ok) throw new Error('Dashboard refresh failed.');
            const data = await response.json();
            renderOverallBoardCharts(data.charts || []);
            renderErrorStop(data.errorStop || { labels: [], values: [] });
            renderOverallRows(overallFeederRows, data.feeders || [], ['feederId', 'feederTable', 'feederSlot', 'side', 'partName', 'totalPickup', 'totalPlacement', 'ppm'], 'No feeder data found.');
            renderOverallRows(overallNozzleRows, data.nozzles || [], ['nozzleSlot', 'head', 'partName', 'totalPickup', 'totalPlacement', 'ppm'], 'No nozzle data found.');
            if (data.filter?.autoRefresh) {
                document.getElementById('overallDashboardTime').value = String(data.filter.shift);
                overallDashboardForm.querySelector('input[name="StartDate"]').value = data.filter.startDate || '';
                overallDashboardForm.querySelector('input[name="EndDate"]').value = data.filter.endDate || '';
            }
        } catch (error) {
            console.error(error);
        } finally {
            overallRefreshInFlight = false;
        }
    };

    overallDashboardForm?.addEventListener('change', event => {
        if (event.isTrusted && overallAutoRefreshInput) overallAutoRefreshInput.value = 'false';
    });
    refreshOverallDashboard();
    const overallRefreshTimer = window.setInterval(refreshOverallDashboard, 30_000);
    window.addEventListener('pagehide', () => window.clearInterval(overallRefreshTimer), { once: true });
</script>

@functions {
    private static IReadOnlyList<SelectListItem> CreateHourOptions(TimeOnly? selectedTime)
    {
        var selectedValue = selectedTime.HasValue
            ? $"{selectedTime.Value.Hour:00}:00"
            : string.Empty;

        var options = new List<SelectListItem>
        {
            new() { Value = string.Empty, Text = string.Empty, Selected = string.IsNullOrEmpty(selectedValue) }
        };

        options.AddRange(Enumerable.Range(0, 24)
            .Select(hour =>
            {
                var value = $"{hour:00}:00";
                return new SelectListItem
                {
                    Value = value,
                    Text = value,
                    Selected = value == selectedValue
                };
            }));

        return options;
    }
}
