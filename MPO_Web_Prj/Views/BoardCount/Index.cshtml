@model MPO_Web_Prj.Models.Report.BoardCountChartViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Board count";
    Layout = "_DashboardLayout";

    var chartPayload = Model.Charts.Select(chart => new
    {
        lineName = chart.LineName,
        labels = chart.Labels,
        series = chart.Series.Select(series => new
        {
            laneName = series.LaneName,
            values = series.Values,
            modelNames = series.ModelNames
        }),
        modelSeries = chart.ModelSeries.Select(series => new
        {
            modelName = series.ModelName,
            values = series.Values
        })
    });
}

<section class="pp-report board-count-page">
    <h1 class="pp-report__title">BOARD COUNT</h1>

    <form class="pp-report__filter board-count-filter"
          asp-controller="BoardCount"
          asp-action="Index"
          method="post">
        <div class="pp-report__field">
            <label asp-for="Filter.Type">Type</label>
            <select asp-for="Filter.Type" id="boardCountType">
                <option value="1">1 Line</option>
                <option value="2">2 Line</option>
                <option value="3">3 Line</option>
                <option value="4">4 Line</option>
            </select>
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.Lane">Lane</label>
            <select asp-for="Filter.Lane" aria-label="Lane filter">
                <option value="1">Lane 1</option>
                <option value="2">Lane 2</option>
                <option value="0">All Lanes</option>
            </select>
        </div>

        <div class="pp-report__field board-count-line-field" data-line-index="1">
            <label asp-for="Filter.Line1">Line 1</label>
            <select asp-for="Filter.Line1" asp-items="@(new SelectList(Model.LineOptions, "Value", "Text", Model.Filter.Line1))"></select>
        </div>

        <div class="pp-report__field board-count-line-field" data-line-index="2">
            <label asp-for="Filter.Line2">Line 2</label>
            <select asp-for="Filter.Line2" asp-items="@(new SelectList(Model.LineOptions, "Value", "Text", Model.Filter.Line2))"></select>
        </div>

        <div class="pp-report__field board-count-line-field" data-line-index="3">
            <label asp-for="Filter.Line3">Line 3</label>
            <select asp-for="Filter.Line3" asp-items="@(new SelectList(Model.LineOptions, "Value", "Text", Model.Filter.Line3))"></select>
        </div>

        <div class="pp-report__field board-count-line-field" data-line-index="4">
            <label asp-for="Filter.Line4">Line 4</label>
            <select asp-for="Filter.Line4" asp-items="@(new SelectList(Model.LineOptions, "Value", "Text", Model.Filter.Line4))"></select>
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.StartDate">Start</label>
            <div style="display: flex; gap: 8px;">
                <input asp-for="Filter.StartDate" type="date" asp-format="{0:yyyy-MM-dd}" />
                <input asp-for="Filter.StartTime" type="time" step="1" asp-format="{0:HH:mm:ss}" />
            </div>
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.EndDate">End</label>
            <div style="display: flex; gap: 8px;">
                <input asp-for="Filter.EndDate" type="date" asp-format="{0:yyyy-MM-dd}" />
                <input asp-for="Filter.EndTime" type="time" step="1" asp-format="{0:HH:mm:ss}" />
            </div>
        </div>

        <button class="pp-report__button" type="submit"><i data-lucide="filter" style="width: 16px; margin-right: 6px;"></i>Apply</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="report-error">@Model.ErrorMessage</div>
    }

    <div class="board-count-grid board-count-grid--@Model.Filter.Type">
        @for (var i = 0; i < Model.Charts.Count; i++)
        {
            <section class="board-count-chart">
                <h2>@Model.Charts[i].LineName</h2>
                <div class="board-count-chart__canvas">
                    <canvas id="boardCountChart@(i)"></canvas>
                </div>
            </section>
        }
    </div>
</section>

<script>
    const boardCountCharts = @Html.Raw(JsonSerializer.Serialize(chartPayload));
    const boardCountModelPalette = [
        '#22D3EE', '#FBBF24', '#A78BFA', '#34D399',
        '#60A5FA', '#C4B5FD', '#5EEAD4', '#93C5FD',
        '#FDE68A', '#D8B4FE', '#86EFAC', '#67E8F9'
    ];

    const modelColorMap = new Map(
        [...new Set(boardCountCharts.flatMap(chart => chart.modelSeries.map(series => series.modelName)))].sort()
            .map((modelName, index) => [modelName, boardCountModelPalette[index % boardCountModelPalette.length]])
    );

    const createIntervalChartData = chart => {
        const boundaryLabels = createBoundaryLabels(chart.labels);

        return {
            boundaryLabels,
            datasets: chart.modelSeries.map(series => ({
                label: series.modelName,
                data: series.values.map((value, valueIndex) => ({
                    x: valueIndex + 0.5,
                    y: value
                })),
                backgroundColor: modelColorMap.get(series.modelName),
                hoverBackgroundColor: modelColorMap.get(series.modelName),
                borderWidth: 0,
                stack: 'board-count'
            }))
        };
    };

    const createBoundaryLabels = labels => {
        if (!labels.length) {
            return [];
        }

        return [...labels, getNextBoundaryLabel(labels)];
    };

    const getNextBoundaryLabel = labels => {
        const lastLabel = labels[labels.length - 1] || '';
        const hourMatch = lastLabel.match(/^(\d{2}):00$/);

        if (!hourMatch) {
            return '';
        }

        const nextHour = Number(hourMatch[1]) + 1;
        return nextHour === 24
            ? '24:00'
            : `${String(nextHour % 24).padStart(2, '0')}:00`;
    };

    const getBoundaryTickStep = (canvas, boundaryLabels) => {
        const boundaryCount = Math.max(boundaryLabels.length - 1, 1);
        const availableWidth = canvas.parentElement?.clientWidth || canvas.clientWidth || 360;
        const maxVisibleLabels = Math.max(2, Math.floor(availableWidth / 48));

        return Math.max(1, Math.ceil(boundaryCount / Math.max(maxVisibleLabels - 1, 1)));
    };

    const getBoundaryTickLabel = (value, canvas, boundaryLabels) => {
        if (!Number.isInteger(value)) {
            return '';
        }

        const lastBoundary = boundaryLabels.length - 1;
        const tickStep = getBoundaryTickStep(canvas, boundaryLabels);
        const isRequiredBoundary = value === 0 || value === lastBoundary;

        return isRequiredBoundary || value % tickStep === 0
            ? boundaryLabels[value] || ''
            : '';
    };

    document.querySelectorAll('.board-count-line-field').forEach(field => {
        const typeSelect = document.getElementById('boardCountType');
        const syncVisibility = () => {
            const activeCount = Number(typeSelect.value || 1);
            const lineIndex = Number(field.dataset.lineIndex);
            field.hidden = lineIndex > activeCount;
        };

        typeSelect.addEventListener('change', syncVisibility);
        syncVisibility();
    });

    boardCountCharts.forEach((chart, index) => {
        const canvas = document.getElementById(`boardCountChart${index}`);
        if (!canvas) {
            return;
        }

        const intervalChart = createIntervalChartData(chart);

        new Chart(canvas, {
            type: 'bar',
            data: {
                datasets: intervalChart.datasets
            },
            options: {
                animation: false,
                maintainAspectRatio: false,
                normalized: true,
                responsive: true,
                resizeDelay: 100,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            title: context => {
                                const bucketIndex = Math.floor(context[0].parsed.x);
                                const start = intervalChart.boundaryLabels[bucketIndex] || '';
                                const end = intervalChart.boundaryLabels[bucketIndex + 1] || '';
                                return end ? `${start} - ${end}` : start;
                            },
                            beforeLabel: context => context.dataset.label,
                            label: context => `Board Count: ${context.parsed.y}`
                        }
                    },
                    title: { display: false }
                },
                scales: {
                    x: {
                        type: 'linear',
                        stacked: true,
                        min: 0,
                        max: Math.max(intervalChart.boundaryLabels.length - 1, 1),
                        ticks: {
                            autoSkip: false,
                            align: 'inner',
                            maxRotation: 60,
                            minRotation: 60,
                            stepSize: 1,
                            callback: value => getBoundaryTickLabel(value, canvas, intervalChart.boundaryLabels)
                        },
                        grid: { display: false, drawTicks: false },
                        border: { display: true, color: 'rgba(216,221,226,0.55)' }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        grid: { display: false, drawTicks: false },
                        border: { display: true, color: '#d8dde2' }
                    }
                },
                datasets: {
                    bar: {
                        barThickness: 32,
                        maxBarThickness: 36
                    }
                }
            }
        });
    });
</script>

@functions {
    private static SelectList CreateHourOptions(TimeOnly? selectedTime)
    {
        var selectedValue = selectedTime.HasValue
            ? $"{selectedTime.Value.Hour:00}:00"
            : string.Empty;

        var hours = Enumerable.Range(0, 24)
            .Select(hour => $"{hour:00}:00")
            .ToList();

        return new SelectList(hours, selectedValue);
    }
}
