@model MPO_Web_Prj.Models.Report.CycleTimeReportViewModel

@{
    ViewData["Title"] = "Cycle Time Report";
    Layout = "_DashboardLayout";

    var visibleCycleColumnCount = 0;
    if (Model.ShowCycleTime1) visibleCycleColumnCount++;
    if (Model.ShowCycleTime2) visibleCycleColumnCount++;
    if (Model.ShowCycleTime3) visibleCycleColumnCount++;
    var emptyColumnCount = 3 + visibleCycleColumnCount;
}

<section class="pp-report">
    <h1 class="pp-report__title"><i data-lucide="clock" style="margin-right: 8px;"></i>CYCLE TIME REPORT</h1>

    <form class="pp-report__filter"
          asp-controller="CycleTimeReport"
          asp-action="Index"
          method="get">
        <div class="pp-report__field">
            <label asp-for="Filter.LineName">Line Name</label>
            <select class="report-linecombo"
                    asp-for="Filter.LineName"
                    asp-items="@(new SelectList(Model.LineOptions, "Value", "Text", Model.Filter.LineName))">
            </select>
        </div>

        <div class="pp-report__field pp-report__field--part">
            <label asp-for="Filter.ModelName">Model Name</label>
            <select class="report-modelcombo"
                    asp-for="Filter.ModelName"
                    asp-items="@(new SelectList(Model.ModelOptions, "Value", "Text", Model.Filter.ModelName))">
            </select>
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.StartDate">Start</label>
            <input asp-for="Filter.StartDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            <input asp-for="Filter.StartTime" type="time" step="1" asp-format="{0:HH:mm:ss}" />
        </div>

        <div class="pp-report__field">
            <label asp-for="Filter.EndDate">End</label>
            <input asp-for="Filter.EndDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            <input asp-for="Filter.EndTime" type="time" step="1" asp-format="{0:HH:mm:ss}" />
        </div>

        <button class="pp-report__button" type="submit"><i data-lucide="filter" style="width: 16px; margin-right: 6px;"></i>Apply</button>

        <button class="pp-report__button"
                type="submit"
                asp-action="ExportExcel"
                style="background: linear-gradient(135deg, #10B981 0%, #059669 100%) !important;">
            <i data-lucide="download" style="width: 16px; margin-right: 6px;"></i>Export Excel
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="report-error">
            @Model.ErrorMessage
        </div>
    }

    <div class="pp-report__header-actions">
        <div class="pp-report__record-count">@Model.Rows.Count records</div>
        <partial name="~/Views/Shared/_ReportPagination.cshtml" model="Model.Pagination" />
    </div>

    <div class="pp-report__table-wrap">
        <table class="pp-report__table pp-report__table--cycle-time">
            <colgroup>
                <col style="width: 170px;" />
                <col style="width: 240px;" />
                <col style="width: 310px;" />
                @if (Model.ShowCycleTime1)
                {
                    <col style="width: 150px;" />
                }
                @if (Model.ShowCycleTime2)
                {
                    <col style="width: 150px;" />
                }
                @if (Model.ShowCycleTime3)
                {
                    <col style="width: 150px;" />
                }
            </colgroup>
            <thead>
                <tr>
                    <th>Line Name</th>
                    <th>Model name</th>
                    <th>Group name</th>
                    @if (Model.ShowCycleTime1)
                    {
                        <th>Cycle<br />time 1</th>
                    }
                    @if (Model.ShowCycleTime2)
                    {
                        <th>Cycle<br />time 2</th>
                    }
                    @if (Model.ShowCycleTime3)
                    {
                        <th>Cycle<br />time 3</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.LineName</td>
                        <td>@row.ModelName</td>
                        <td>@row.GroupName</td>
                        @if (Model.ShowCycleTime1)
                        {
                            <td>@FormatCycleTime(row.CycleTime1)</td>
                        }
                        @if (Model.ShowCycleTime2)
                        {
                            <td>@FormatCycleTime(row.CycleTime2)</td>
                        }
                        @if (Model.ShowCycleTime3)
                        {
                            <td>@FormatCycleTime(row.CycleTime3)</td>
                        }
                    </tr>
                }

                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td class="pp-report__empty" colspan="@emptyColumnCount">
                            No cycle time data found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@functions {
    private static string FormatCycleTime(decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString("N2")
            : string.Empty;
    }
}
